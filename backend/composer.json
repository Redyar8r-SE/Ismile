{
    "name": "ismile/backend",
    "description": "iSmile 2026 registrations, payments and tickets",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "tecnickcom/tcpdf": "6.10.1"
    },
    "autoload": {
        "psr-4": {
            "Ismile\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
