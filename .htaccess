# iSmile website on Apache / LiteSpeed (cPanel hosting).
# GitHub Pages ignores this file; it only matters on the real server.

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always HTTPS (the padlock), and one address: without "www".
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Never serve these, even if they are uploaded by mistake: the backend code
  # and its settings, the internal documents, the tools, Git's own files.
  RewriteRule ^(backend|docs|tools|netlify|\.git)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteRule ^(README\.md|netlify\.toml|composer\.(json|lock)|\.cpanel\.yml)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  # Browsers must use HTTPS for a year once they have seen the site.
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# The content admin's language and data files change often: never cache them long.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
